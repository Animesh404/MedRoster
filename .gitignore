.superpowers/

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI binary, downloaded by the `supabase` npm dev dependency.
# 97MB — it must never be committed again (it was once, see git history).
supabase-go

# Understand Anything — generated graph artifacts (config + ignore are committed)
.understand-anything/intermediate/
.understand-anything/tmp/
.understand-anything/.trash-*/
.understand-anything/knowledge-graph.json
.understand-anything/meta.json
.understand-anything/fingerprints.json
