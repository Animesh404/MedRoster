generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MANAGER
  STAFF
}

enum Profession {
  DOCTOR
  NURSE
  RECEPTIONIST
}

enum ImportSource {
  SEED
  UPLOAD
}

enum FileKind {
  STAFF
  SHIFT
}

enum RowOutcome {
  ACCEPTED
  REPAIRED
  MERGED
  REJECTED
}

model User {
  id            Int         @id @default(autoincrement())
  email         String      @unique
  name          String
  role          Role
  profession    Profession?
  externalId    Int?        @unique
  /// Supabase auth.users.id. NULL means a profile with no account — a real
  /// roster record (e.g. imported from staff.csv) that has never been invited.
  authUserId    String?     @unique
  /// Set when a manager offboards someone. The Supabase user is banned at the
  /// same time; future claims are released. See DECISIONS.md.
  deactivatedAt DateTime?   @db.Timestamptz(3)
  /// "light" | "dark" | "system". Stored so the choice follows somebody to a
  /// new device rather than living only in that browser's cookie. NULL means
  /// never chosen, which reads as "system" — the behaviour everyone had before
  /// the toggle existed.
  themePreference String?   @db.VarChar(16)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  claims        Claim[]     @relation("ClaimHolder")
  assignedBy    Claim[]     @relation("ClaimAssigner")
  importRuns    ImportRun[]
  dropNotices   DropNotice[]
}

model Shift {
  id                  Int      @id @default(autoincrement())
  startsAt            DateTime @db.Timestamptz(3)
  endsAt              DateTime @db.Timestamptz(3)
  version             Int      @default(0)
  seriesId            Int?
  detachedFromSeries  Boolean  @default(false)
  externalId          Int?     @unique
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  series        ShiftSeries?       @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  requirements  ShiftRequirement[]
  claims        Claim[]

  @@index([startsAt, endsAt])
  @@index([seriesId])
}

model ShiftRequirement {
  id            Int        @id @default(autoincrement())
  shiftId       Int
  profession    Profession
  requiredCount Int

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([shiftId, profession])
}

model Claim {
  id           Int      @id @default(autoincrement())
  shiftId      Int
  userId       Int
  assignedById Int?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  shift      Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user       User  @relation("ClaimHolder",  fields: [userId],       references: [id], onDelete: Cascade)
  assignedBy User? @relation("ClaimAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([shiftId, userId])
  @@index([userId])
}

model ShiftSeries {
  id           Int      @id @default(autoincrement())
  weekdays     Int[]                       // 0=Sun … 6=Sat
  startTime    String                      // "08:00" clinic-local
  endTime      String                      // "16:00" clinic-local
  untilDate    DateTime @db.Date
  requirements Json                        // { DOCTOR: 1, NURSE: 2, RECEPTIONIST: 0 }
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  shifts Shift[]
}

model ImportRun {
  id        Int          @id @default(autoincrement())
  source    ImportSource
  fileKind  FileKind
  filename  String
  actorId   Int?
  stats     Json
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  actor User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)
  rows  ImportRowResult[]

  @@index([createdAt])
}

model ImportRowResult {
  id          Int        @id @default(autoincrement())
  importRunId Int
  rowNumber   Int
  rawRow      String
  outcome     RowOutcome
  issues      Json
  entityId    Int?

  run ImportRun @relation(fields: [importRunId], references: [id], onDelete: Cascade)

  @@index([importRunId, rowNumber])
}

/// Idempotency record for a client-supplied `mutationId`.
///
/// Written inside the same transaction as the mutation it describes, so the
/// recorded answer and the effect can never disagree: either both committed or
/// neither did. A retry with the same key replays `result` verbatim instead of
/// re-running the rules.
model MutationOutcome {
  mutationId String   @id
  /// Fingerprint of the request this key was minted for (operation + shift +
  /// user). A key presented for a DIFFERENT request is a client bug, not a
  /// retry, and is refused rather than replayed — otherwise one person's key
  /// could hand them another person's answer.
  scope      String
  /// The exact value the original call returned: `{ claimId }` or an AppError.
  result     Json
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
}

/// A durable record that a member lost a shift they were holding.
///
/// Previously reconstructed from `EventOutbox` at render time, which made the
/// outbox impossible to prune: deleting an event deleted a notice a nurse might
/// never have seen. `/my-shifts` calls this "the one thing a staff member
/// cannot be left to discover only by noticing a shift missing on the day", so
/// it needs a store of its own rather than a side effect of a replay log.
///
/// The shift's own times are SNAPSHOT here rather than joined. A deletion
/// removes the `Shift` row entirely, and the old code recovered its times by
/// digging through that shift's `shift.created`/`shift.edited` history — which
/// only worked while those events survived.
model DropNotice {
  id            Int       @id @default(autoincrement())
  userId        Int
  shiftId       Int
  /// 'dropped' — an edit made them ineligible. 'deleted' — the shift is gone.
  kind          String
  reason        String
  /// Snapshot, not a join: the Shift row may no longer exist.
  shiftStartsAt DateTime? @db.Timestamptz(3)
  shiftEndsAt   DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  /// Set when the member acknowledges it. Notices also stop showing once
  /// `shiftStartsAt` is past, so an unread one cannot accumulate forever.
  dismissedAt   DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dismissedAt])
}

/// How far `EventOutbox` has been pruned.
///
/// A single row (`id = 1`). Exists so `GET /api/events/since` can tell a client
/// that its cursor has fallen off the end of the log — without this, a client
/// polling `WHERE id > lastId` for events that were deleted receives an empty
/// page and concludes it is CAUGHT UP, silently missing every change since.
/// That is the failure that made pruning the outbox unsafe.
model OutboxWatermark {
  id         Int      @id @default(1)
  /// Highest `EventOutbox.id` that has been deleted. A client whose cursor is
  /// below this has provably missed events and must resync rather than poll on.
  prunedUpTo BigInt   @default(0)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
}

model EventOutbox {
  id         BigInt   @id @default(autoincrement())
  topic      String
  type       String
  payload    Json
  mutationId String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([topic, id])
}
