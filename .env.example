DATABASE_URL=postgresql://medroster:medroster@localhost:5432/medroster
AUTH_SECRET=change-me
# Required in production for self-hosted deployments (we are not on Vercel/CF
# Pages, which set this implicitly). Without it, Auth.js's `trustHost` option
# defaults to false whenever NODE_ENV=production, and every session read in
# middleware throws `UntrustedHost` and is treated as unauthenticated — even
# for users who really are signed in. Not needed for `next dev` (defaults to
# true there). See https://errors.authjs.dev#untrustedhost
AUTH_TRUST_HOST=true
CLINIC_TZ=Europe/London
SEED_PASSWORD=medroster123
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe key. Newer Supabase projects issue sb_publishable_... which
# supersedes the legacy anon JWT; either works, publishable is preferred.
# NEVER put an sb_secret_... key behind a NEXT_PUBLIC_ name — Next inlines
# those into the client bundle.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
