# ---------------------------------------------------------------------------
# Which environment this process runs as. Selects DATABASE_URL_DEV or
# DATABASE_URL_PROD below.
#
# Deliberately NOT NODE_ENV: Next owns that and forces it to "production" for
# any production build — including one you intend to run against dev data. A
# separate switch lets you express "production build, local database", which is
# exactly what you want when reproducing a bug.
#
#   development | production
# ---------------------------------------------------------------------------
APP_ENV=development

# Local Postgres from Supabase CLI stack (`npx supabase start`), on port 54322.
# Shared with Supabase Auth for user data.
DATABASE_URL_DEV=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Postgres.
# Dashboard -> Project Settings -> Database -> Connection string -> URI.
#
# Realtime only works against this one: broadcasts are emitted by a trigger on
# the database, and the migration installs that trigger only where a `realtime`
# schema exists. Against local Postgres the trigger is skipped and the app falls
# back to polling, which works fully.
DATABASE_URL_PROD=

# Escape hatch — when set, this wins over APP_ENV entirely.
# `docker compose` injects it, Testcontainers hands each test file a throwaway
# URL, and CI sets its own. Leave it unset for normal local work.
# DATABASE_URL=

# ---------------------------------------------------------------------------
# Supabase Auth (required)
# ---------------------------------------------------------------------------
# Supabase Auth requires both URL and publishable key. `npx supabase start`
# prints all of these. Both halves are also needed for realtime — the app falls
# back to polling without them.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key from `npx supabase start`>

# Browser-safe key. Newer Supabase projects issue sb_publishable_... which
# supersedes the legacy anon JWT; either works, publishable is preferred.
# NEVER put an sb_secret_... key behind a NEXT_PUBLIC_ name — Next inlines
# those into the client bundle.

# Server-only. NEVER prefix this with NEXT_PUBLIC_ — Next inlines those into
# the client bundle, and this key bypasses every access rule.
SUPABASE_SERVICE_ROLE_KEY=<secret key from `npx supabase start`>

# Absolute origin used to build invite / recovery redirect targets.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Clinic
# ---------------------------------------------------------------------------
# Roster times are wall-clock in this zone; storage is always UTC.
CLINIC_TZ=Europe/London

# Shared password for every seeded account. Documented in the README.
SEED_PASSWORD=medroster123

# ---------------------------------------------------------------------------
# Scheduled tasks
# ---------------------------------------------------------------------------
# Shared secret for POST /api/cron/prune, which clears expired idempotency
# records (lib/rules/retention.ts). Vercel Cron sends it as a bearer token.
# The route REFUSES to run when this is unset rather than sitting open — so
# leaving it blank means the MutationOutcome table grows unchecked.
# Generate with: openssl rand -hex 32
CRON_SECRET=
